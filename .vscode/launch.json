{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "FastAPI: gemi-brain",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "python": "/Users/test/Projects/gemi-brain/.venv/bin/python",
      "cwd": "/Users/test/Projects/gemi-brain",
      "console": "internalConsole",
      "env": {
        "PYDEVD_DISABLE_FILE_VALIDATION": "1"
      },
      "args": [
        "app.main:app",
        "--host",
        "127.0.0.1",
        "--port",
        "8000"
      ],
      "serverReadyAction": {
        "pattern": "Uvicorn running on (https?://\\S+)",
        "uriFormat": "%s/docs",
        "action": "openExternally"
      },
      "jinja": true,
      "justMyCode": true
    }
  ]
}
